# ---- Application ----
DEBUG=false
SECRET_KEY=a3f8c2e1d9b7f4e6c2a1d8b5e3f7c9a2d4b6e8f1c3a5d7b9e2f4c6a8d1b3e5f7
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["*"]

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://beps_user:beps_pass@db:5432/beps_db
DB_ECHO=false

# ---- JWT ----
JWT_SECRET_KEY=b5e9f3c7a1d4b8e2f6c9a3d7b1e5f8c2a6d9b3e7f1c4a8d2b6e9f3c7a1d5b8e2
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Blockchain ----
BLOCKCHAIN_RPC_URL=http://host.docker.internal:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_CHAIN_ID=31337

# ---- Smart Contract Addresses ----
EVIDENCE_REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
CUSTODY_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# ---- Storage ----
EVIDENCE_STORAGE_PATH=/app/evidence_storage
MAX_FILE_SIZE_MB=500

# ---- IPFS (optional) ----
IPFS_ENABLED=false
IPFS_API_URL=http://ipfs:5001

# ---- Security ----
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12